<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Enrollment System</title>
<style>
  body { font-family: system-ui, sans-serif; margin: 0; background: #f6f7f9; color: #1c2230; }
  header { display: flex; align-items: center; gap: 24px; padding: 12px 24px; background: #1c2230; color: #fff; }
  header a { color: #cfd6e4; text-decoration: none; }
  header a:hover { color: #fff; }
  header .who { margin-left: auto; color: #9aa4b8; }
  header form { margin: 0; }
  main { max-width: 860px; margin: 32px auto; padding: 0 16px; }
  table { width: 100%; border-collapse: collapse; background: #fff; }
  th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid #e3e6ec; }
  th { background: #eef0f4; font-weight: 600; }
  .ok { background: #e3f4e8; border: 1px solid #9cd3ae; padding: 10px 14px; }
  .err { background: #fbe7e7; border: 1px solid #e3a3a3; padding: 10px 14px; }
  .muted { color: #6b7385; }
  input, textarea, button { font: inherit; padding: 6px 10px; }
  textarea { width: 100%; box-sizing: border-box; }
  label { display: block; margin: 12px 0 4px; }
  input[type=text] { width: 100%; box-sizing: border-box; }
  .post { background: #fff; border: 1px solid #e3e6ec; padding: 14px 18px; margin: 12px 0; }
  .post h3 { margin: 0 0 4px; }
  .post p { white-space: pre-wrap; margin: 8px 0 0; }
  .note { background: #fff6e0; border: 1px solid #e8c879; padding: 10px 14px; }
</style>
</head>
<body>
<header>
  <b>Enrollment System</b>
  <% if (user) { %>
    <a href="/courses">Courses</a>
    <a href="/grades">Grades</a>
    <a href="/schedule">Schedule</a>
    <a href="/announcements">Announcements</a>
    <span class="who"><%= user.sub %> (<%= user.role %>)</span>
    <form method="post" action="/logout"><button>Log out</button></form>
  <% } %>
</header>
<main>
<% if (msg) { %><p class="ok"><%= msg %></p><% } %>
<% if (error) { %><p class="err"><%= error %></p><% } %>
